  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(CkzPort)swerve_compat;$(CkzPort)include;$(CkzSDL)\include;$(CkzOpenAL)\include;$(CkzUnicorn)include;$(CkzThirdParty)\gl-include;$(CkzThirdParty)\powervr;$(CkzRoot)CKZ_source\packages\platformglu\src\logg\include;$(CkzRoot)CKZ_source\packages\platformglu\src\lvorbis\include;%(AdditionalIncludeDirectories);$(CkzGameIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>CKZ_PC;NDEBUG;WIN32;WIN32_LEAN_AND_MEAN;NOMINMAX;_CRT_SECURE_NO_WARNINGS;_CRT_NONSTDC_NO_DEPRECATE;_CRT_STDIO_ISO_WIDE_SPECIFIERS;KHRONOS_STATIC;GL_GLEXT_PROTOTYPES;crc32=ckz_zlib_crc32;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <RuntimeTypeInfo>false</RuntimeTypeInfo>
      <BufferSecurityCheck>false</BufferSecurityCheck>
      <ExceptionHandling>false</ExceptionHandling>
      <!-- Source paths begin with ..\ from vs\, so reserve one level under IntDir. -->
      <ObjectFileName>$(IntDir)src\%(RelativeDir)</ObjectFileName>
      <AdditionalOptions>/utf-8 /Zc:sizedDealloc- /clang:-fwrapv /clang:-fno-strict-aliasing /clang:-Wno-c++11-narrowing %(AdditionalOptions)</AdditionalOptions>
      <AdditionalOptions Condition="'$(CkzAddressSanitizer)' == 'true'">/fsanitize=address %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
