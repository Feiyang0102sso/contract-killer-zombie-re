// Resources embedded in zombsniper.exe: the program icon and the version number.

// The first icon in the exe is what Explorer, the taskbar and the SDL window use.
1 ICON "../assets/Icon.ico"

// Version 1.0.0 (1 = VS_VERSION_INFO)
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileVersion", "1.0.0"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
