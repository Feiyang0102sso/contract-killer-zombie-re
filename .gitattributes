# Normalize source files to LF.
* text=auto eol=lf

# Windows launchers need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf

# Prebuilt blocks regenerated from the original binary (Swerve, OpenSSL):
# excluded from GitHub language statistics and collapsed in diffs
*.s linguist-generated=true

# Binary files
*.png binary
*.jpg binary
*.dmg binary
*.dll binary
*.lib binary
CKZ_source/pc_port/swerve_compat/swerve-arm.bin binary
*.patch text eol=lf
